# U Thrive 365 environment example
# Copy values from here into your local shell, Docker/Replit environment,
# or Replit Secrets. Do not commit a real .env file.

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
# Local Docker example used by scripts/start-local.ps1:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uthrive365

# Session secret
# Currently reserved for session/auth-related server code. Keep it configured
# in Replit Secrets because the Replit project already provides it.
SESSION_SECRET=replace-with-a-long-random-secret

# Email delivery through Resend
# Set this to true for local form testing when you do not want real emails sent.
# In production/Replit, remove this variable or set it to false.
EMAIL_DELIVERY_DISABLED=true

# Required when EMAIL_DELIVERY_DISABLED is not true.
RESEND_API_KEY=re_replace_with_resend_api_key
EMAIL_FROM="U Thrive 365 <hello@uthrive365.com>"

# Optional because the server defaults to hello@uthrive365.com,
# but keeping it explicit makes the deployment easier to audit.
EMAIL_TO=hello@uthrive365.com
